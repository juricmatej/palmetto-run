{
  "name": "palmetto-run",
  "version": "1.0.0",
  "description": "A neon open-world crime sandbox in the browser, built with Three.js. Runs as a Claude Artifact with live multiplayer.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
